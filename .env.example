# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=postgres

# FYERS market data
FYERS_CLIENT_ID=your_app_id
FYERS_APP_SECRET=your_app_secret
FYERS_ACCESS_TOKEN=your_access_token
MARKET_DATA_PROVIDER=fyers
FYERS_LIVE_SYMBOLS=NSE:NIFTY50-INDEX

# Safety: Stage 1 is data-only and must never submit a real order.
TRADE_MODE=paper
PAPER_TRADING_ONLY=true
ENABLE_LIVE_ORDER_EXECUTION=false

# Trading Parameters
INITIAL_CAPITAL=50000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=0.05
SCORE_THRESHOLD=0.6

# Model
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
